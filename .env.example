# SpendSense — local environment variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
#
# SpendSense uses SQLite (via better-sqlite3) — no external
# database server required. The database is a single file
# on disk; no connection string is needed.

# Path to the SQLite database file.
# Defaults to ./spendsense.db in the project root if unset.
SQLITE_PATH=./spendsense.db

# Node environment (set to 'production' for Docker deployments)
NODE_ENV=development
